{
  "name": "vscode-local-ai",
  "displayName": "VS Code Local AI",
  "description": "一款vscode扩展程序，支持本地电脑部署和内网部署模型调用，具备类似Cline的文件读写和代码编写能力。",
  "version": "1.0.0",
  "scripts": {
    "test": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p .",
    "package": "vsce package -o ./dist/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lanscod88/vscode-local-ai.git"
  },
  "readme": "README.md",
  "engines": {
    "vscode": "^1.140.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "local-ai-sidebar",
          "title": "本地AI对话",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "local-ai-sidebar": [
        {
          "type": "webview",
          "id": "ollamaChatView",
          "name": "本地AI对话",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-local-ai.openSettings",
        "title": "API Configuration",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscode-local-ai.openSettings",
          "when": "view == ollamaChatView",
          "group": "navigation"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.140.0",
    "typescript": "^5.0.0"
  }
}
