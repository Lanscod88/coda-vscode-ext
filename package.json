{
  "name": "coda-vscode-ext",
  "displayName": "VS Code Local AI",
  "description": "Coda-VSCode-Ext是一款vscode扩展程序",
  "version": "0.0.10",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p .",
    "package": "vsce package -o ./extension-package/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lanscod88/coda-vscode-ext.git"
  },
  "readme": "README.md",
  "engines": {
    "vscode": "^1.140.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "local-ai-sidebar",
          "title": "本地AI对话",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "local-ai-sidebar": [
        {
          "type": "webview",
          "id": "ollamaChatView",
          "name": "本地AI对话",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-local-ai.openSettings",
        "title": "API Configuration",
        "icon": "$(settings-gear)"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "typescript": "^7.0.2"
  }
}
